{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CampusFind API",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "campusfind-api",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "endsPattern": ".*server_started.*"
                }
            }
        }
    ]
}
